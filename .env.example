# ---------- General ----------
# true = log messages instead of sending. Set false to go live.
DRY_RUN=true
DB_PATH=keystone.db
PORT=3000
# Public URL of this server; used for webhooks and unsubscribe links.
PUBLIC_BASE_URL=https://your-domain.com
# Required before exposing the dashboard/API publicly.
DASHBOARD_TOKEN=
# Signs unsubscribe links. Set a long random string.
APP_SECRET=change-me

# ---------- Lead generator ----------
# Google Places API (New) — Text Search
GOOGLE_PLACES_API_KEY=
# Optional: finds named decision-makers' emails
HUNTER_API_KEY=

# ---------- AI personalization (Claude) ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# Set to true to use an `ant auth login` profile instead of an API key.
# ANTHROPIC_ENABLE=true

# ---------- Who the outreach is from ----------
SENDER_NAME=Alex
SENDER_TITLE=Founder
SENDER_COMPANY=Keystone Web
SENDER_OFFER=We build fast, mobile-friendly websites for local businesses that turn visitors into booked calls.
BOOKING_URL=https://cal.com/you/15min
# Required by CAN-SPAM
SENDER_PHYSICAL_ADDRESS=123 Main St, Austin, TX 78701

# ---------- Email ----------
# resend | gmail | none
EMAIL_PROVIDER=resend
EMAIL_FROM=Alex <alex@mail.your-domain.com>
EMAIL_REPLY_TO=alex@your-domain.com
RESEND_API_KEY=
# whsec_... from the Resend webhook settings
RESEND_WEBHOOK_SECRET=
GMAIL_USER=
# Google Account → Security → App passwords
GMAIL_APP_PASSWORD=

# ---------- SMS (Twilio) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use a from-number or a messaging service SID
TWILIO_FROM_NUMBER=+15125550100
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VALIDATE_SIGNATURE=true

# ---------- Approval / automation rules ----------
# manual = a human approves every draft; auto = rules decide
APPROVAL_MODE=manual
# Auto mode: approve leads with fit score >= this (and an email)
AUTO_APPROVE_MIN_SCORE=70
# Skip leads below this score entirely
MIN_SCORE=30
DAILY_EMAIL_LIMIT=50
DAILY_SMS_LIMIT=25
# Local hours, 24h clock
SEND_WINDOW_START=9
SEND_WINDOW_END=17
SEND_ON_WEEKENDS=false
TIMEZONE=America/New_York
# TCPA: only text leads with recorded consent
SMS_REQUIRE_CONSENT=true
# SMS follows the email after N days if no reply
SMS_DELAY_DAYS=2
# Comma-separated, e.g. gov,edu
BLOCKED_DOMAINS=
# Comma-separated substrings
BLOCKED_INDUSTRIES=
