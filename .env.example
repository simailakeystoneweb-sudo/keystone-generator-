# ---------- General ----------
# true = log messages instead of sending. Set false to go live.
DRY_RUN=true
DB_PATH=keystone.db
PORT=3000
# Public URL of this server; used for webhooks and unsubscribe links.
PUBLIC_BASE_URL=https://your-domain.com
# Required before exposing the dashboard/API publicly.
DASHBOARD_TOKEN=
# Signs unsubscribe links. Set a long random string.
APP_SECRET=change-me
# Set true only when running behind a reverse proxy (nginx, Render, Fly…)
TRUST_PROXY=false

# ---------- Lead generator ----------
# Google Places API (New) — Text Search
GOOGLE_PLACES_API_KEY=
# Optional: finds named decision-makers' emails
HUNTER_API_KEY=

# ---------- AI (Claude) — server-side only, never exposed to the browser ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# Max AI requests per client per minute (0 = unlimited)
AI_RATE_LIMIT_PER_MINUTE=20
# Max email/SMS send requests per client per minute (0 = unlimited)
SEND_RATE_LIMIT_PER_MINUTE=10

# ---------- Who the outreach is from ----------
SENDER_NAME=Alex
SENDER_TITLE=Founder
SENDER_COMPANY=Keystone Web Agency
SENDER_OFFER=We build fast, mobile-friendly websites for local businesses that turn visitors into booked calls.
BOOKING_URL=https://cal.com/you/15min
# Required by CAN-SPAM
SENDER_PHYSICAL_ADDRESS=123 Main St, Austin, TX 78701

# ---------- Email (Resend) — server-side only, never exposed to the browser ----------
# resend | gmail | none
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Must be on a domain you've verified in Resend (set up SPF/DKIM there).
OUTREACH_FROM_EMAIL=
OUTREACH_FROM_NAME=Keystone Web Agency
EMAIL_REPLY_TO=
# whsec_... from Resend → Webhooks. Required: unsigned webhook calls are refused.
RESEND_WEBHOOK_SECRET=
# Gmail SMTP alternative (EMAIL_PROVIDER=gmail)
GMAIL_USER=
# Google Account → Security → App passwords
GMAIL_APP_PASSWORD=

# ---------- SMS (Twilio) — server-side only, never exposed to the browser ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164, e.g. +15125550100 (register it for A2P 10DLC in Twilio)
TWILIO_PHONE_NUMBER=
# Optional: send through a Messaging Service instead of a single number
TWILIO_MESSAGING_SERVICE_SID=
# Leave true. false skips webhook signature checks (local testing only).
TWILIO_VALIDATE_SIGNATURE=true
# No texts between these local hours (TIMEZONE below). TCPA: no texts before 8am / after 9pm.
SMS_QUIET_HOURS_START=21
SMS_QUIET_HOURS_END=8

# ---------- Approval / automation rules ----------
# manual = a human approves every draft; auto = rules decide
APPROVAL_MODE=manual
# Auto mode: approve leads with fit score >= this (and an email)
AUTO_APPROVE_MIN_SCORE=70
# Skip leads below this score entirely
MIN_SCORE=30
DAILY_EMAIL_LIMIT=50
DAILY_SMS_LIMIT=25
# Local hours, 24h clock
SEND_WINDOW_START=9
SEND_WINDOW_END=17
SEND_ON_WEEKENDS=false
TIMEZONE=America/New_York
# TCPA: only text leads with recorded consent
SMS_REQUIRE_CONSENT=true
# SMS follows the email after N days if no reply
SMS_DELAY_DAYS=2
# Comma-separated, e.g. gov,edu
BLOCKED_DOMAINS=
# Comma-separated substrings
BLOCKED_INDUSTRIES=
